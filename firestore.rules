rules_version = '2';

// 행성 합치기 게임 — Firestore 보안 규칙 (Data.md 5장, 8장)
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 "게시"하세요.
// ※ "테스트 모드"를 그대로 두면 누구나 모든 데이터를 지울 수 있습니다. 반드시 교체하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{scoreId} {
      // 누구나 순위표를 볼 수 있음 (로그인 없이 링크만으로 접속하는 구조)
      allow read: if true;

      // 새 기록 등록만 허용 — 수정·삭제는 콘솔에서 교사만 가능
      allow create: if isValidScore(request.resource.data);
      allow update, delete: if false;
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }

    // 개인정보 보호: 별명·점수·도달 천체·시각·기간열쇠만 저장하며, 그 외 필드는 아예 거부합니다.
    // (dayKey/weekKey/monthKey = 어느 기간 순위에 속하는지 나타내는 값. 초기화 주기 설정에 사용)
    function isValidScore(data) {
      return data.keys().hasOnly(['nickname', 'score', 'stageReached', 'createdAt', 'dayKey', 'weekKey', 'monthKey', 'room'])
        // 학급 코드: 영문 소문자·숫자·하이픈 2~20자 ('all' = 전체 순위표)
        && data.room is string
        && data.room.matches('^[a-z0-9][a-z0-9-]{0,18}[a-z0-9]$')
        && data.dayKey is string
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.weekKey is string
        && data.weekKey.matches('^W[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string
        && data.monthKey.matches('^M[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.nickname is string
        && data.nickname.size() > 0
        && data.nickname.size() <= 20         // leaderboardConfig.js 의 NICKNAME_MAX 와 동일하게
        // 게임이 제공하는 별명 조합만 허용 — 개발자도구로 임의의 말을 넣어도 서버에서 거부됨
        && data.nickname.matches('^(용감한|씩씩한|심약한|수줍은|다정한|엉뚱한|느긋한|부지런한|명랑한|진지한|상냥한|똑똑한|재빠른|든든한|장난스런|우아한|침착한|유쾌한|소심한|대범한|신중한|활발한|정직한|슬기로운|까칠한|무뚝뚝한|느릿한|엉성한|깜찍한|늠름한) (안경쓴|콧물나는|춤추는|노래하는|잠자는|하품하는|모자쓴|목도리한|우주복입은|우산쓴|장화신은|별을든|책읽는|웃고있는|달리는|구르는|헤엄치는|점프하는|낮잠자는|간식먹는|사진찍는|손흔드는|훌쩍이는|재채기하는|딸꾹질하는|기지개켜는|휘파람부는|망원경든|풍선든|케이크든) (코끼리|호랑이|사자|토끼|다람쥐|고양이|강아지|판다|펭귄|여우|곰|늑대|사슴|기린|하마|고래|돌고래|거북이|문어|오리|부엉이|독수리|참새|개구리|두더지|햄스터|고슴도치|너구리|수달|알파카|카피바라|나무늘보)$') // NICKNAME_PATTERN (자동 생성: npm run rules)
        && data.score is int
        && data.score >= 0
        && data.score <= 100000               // leaderboardConfig.js 의 MAX_SCORE 와 동일하게
        && data.stageReached is string
        && data.stageReached.size() <= 12
        && data.createdAt == request.time;    // 시간 조작 방지 (서버 시각만 허용)
    }
  }
}
